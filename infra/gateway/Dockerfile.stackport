FROM node:24-alpine AS web-build

WORKDIR /src/mw-web-admin

COPY mw-web-admin/package.json mw-web-admin/package-lock.json ./
RUN npm ci

COPY mw-web-admin/ ./

ARG VITE_ADMIN_API_BASE_URL
ARG VITE_IDENTITY_PUBLIC_URL
ARG VITE_EMAIL_API_BASE_URL
ENV VITE_ADMIN_API_BASE_URL=${VITE_ADMIN_API_BASE_URL}
ENV VITE_IDENTITY_PUBLIC_URL=${VITE_IDENTITY_PUBLIC_URL}
ENV VITE_EMAIL_API_BASE_URL=${VITE_EMAIL_API_BASE_URL}

RUN npm run build

FROM nginx:1.29-alpine

COPY infra/gateway/nginx.conf /etc/nginx/nginx.conf
COPY --from=web-build /src/mw-web-admin/dist/ /usr/share/nginx/html/
