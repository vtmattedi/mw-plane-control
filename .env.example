# =============================================================================
# MW Plane Control — canonical environment template
# =============================================================================
#
# This file documents every variable consumed by:
#   - docker-compose-dev.yml
#   - docker-compose.stackport.yml
#   - the production Vite build in infra/gateway/Dockerfile.stackport
#
# DEPLOYMENT SETUP
# ----------------
# 1. Copy this file to `.env` in the repository root.
# 2. Replace every value marked REQUIRED SECRET or REQUIRED CREDENTIAL.
# 3. Keep `.env` out of Git. It is already ignored by this repository.
# 4. In Stackport, create the environment file at the relative path `.env`.
# 5. Validate the production Compose definition without displaying secrets:
#
#      docker compose --env-file .env -f docker-compose.stackport.yml config --quiet
#
# Managed Stackport projects never publish host ports. In the project domain
# settings, route admin.mattediworks.com and identity.mattediworks.com to
# gateway:8080. GATEWAY_HOST_PORT below is only used locally.
#
# Values must stay on one line. Do not wrap values in angle brackets in the
# real `.env`; angle-bracket values below are placeholders, not valid secrets.
# =============================================================================


# =============================================================================
# Build metadata
# =============================================================================
# Embedded into the Identity and BFF Go binaries. Stackport/CI should ideally
# replace these with the release tag, full Git commit, and an RFC 3339 UTC time.
# Example BUILD_TIMESTAMP: 2026-08-14T18:30:00Z

BUILD_VERSION=production
BUILD_COMMIT=unknown
BUILD_TIMESTAMP=unknown


# =============================================================================
# Local Gateway / Vite development
# =============================================================================
# Used only by docker-compose-dev.yml. It binds to 127.0.0.1, not every host
# interface. Vite runs separately at http://localhost:5173 and proxies /api to
# this Gateway port.

GATEWAY_HOST_PORT=3050


# =============================================================================
# Frontend build-time configuration
# =============================================================================
# IMPORTANT: Vite substitutes these values while building the Gateway image.
# Changing them in a running container does nothing; rebuild the Gateway image.
#
# VITE_ADMIN_API_BASE_URL must be an absolute HTTP(S) URL ending in /api or
# /admin/api. Current control-plane pages use same-origin /api; this value also
# supports legacy reusable admin components.
#
# VITE_IDENTITY_PUBLIC_URL is where the browser opens first-access, login, TOTP,
# recovery, and passkey pages. Never use an internal Docker hostname here.
#
# VITE_EMAIL_API_BASE_URL is the browser-facing MW Mail URL used by MailTester.
# MW Mail must allow the admin origin in its request-origin policy.

VITE_ADMIN_API_BASE_URL=https://admin.mattediworks.com/api
VITE_IDENTITY_PUBLIC_URL=https://identity.mattediworks.com
VITE_EMAIL_API_BASE_URL=https://mailgo.mattediworks.com


# =============================================================================
# MW Identity — public URLs and persistence
# =============================================================================
# The production Compose fixes APP_ENV=production, PORT=7100, and
# DATABASE_PATH=/app/data/identity.db. The database is stored in a named volume.
#
# IDENTITY_PUBLIC_ISSUER is the canonical OIDC issuer. It must exactly match:
#   - BFF_IDENTITY_ISSUER
#   - the issuer registered by downstream resource services
#   - the public HTTPS URL presented to browsers
# Do not add a trailing slash.

IDENTITY_PUBLIC_ISSUER=https://identity.mattediworks.com

# Browser session lifetime. 168 hours = 7 days.
IDENTITY_SESSION_TTL_HOURS=168

# Login CSRF token lifetime and per-IP password-login rate limit.
IDENTITY_LOGIN_CSRF_TTL_MINUTES=10
IDENTITY_LOGIN_RATE_ATTEMPTS=10
IDENTITY_LOGIN_RATE_WINDOW_MINUTES=5


# =============================================================================
# MW Identity — signing-key encryption
# =============================================================================
# REQUIRED SECRET.
#
# This key encrypts Identity's persisted OIDC signing keys. It is not the JWT
# signing key itself. Format:
#
#   <version>:<base64url-without-padding-32-byte-key>
#
# Multiple versions are comma-separated during rotation:
#
#   1:<old-key>,2:<new-key>
#
# The active version must exist in IDENTITY_SIGNING_KEYS. Preserve old versions
# until every record encrypted with them has been rotated or retired. Never
# reuse this material for WebAuthn, TOTP, or BFF transactions.

IDENTITY_SIGNING_KEYS=1:<REQUIRED-BASE64URL-32-BYTE-KEY>
IDENTITY_SIGNING_ACTIVE_KEY_VERSION=1

# OIDC token lifetimes. Short delegated tokens reduce downstream exposure.
IDENTITY_AUTHORIZATION_CODE_TTL_MINUTES=5
IDENTITY_ACCESS_TOKEN_TTL_MINUTES=60
IDENTITY_ID_TOKEN_TTL_MINUTES=5
IDENTITY_DELEGATED_TOKEN_TTL_MINUTES=5


# =============================================================================
# MW Identity — WebAuthn / passkeys
# =============================================================================
# RP ID is a hostname only: no scheme, port, path, or trailing slash.
# Origins are exact browser origins and must use HTTPS in production.
# For multiple accepted origins, use the format supported by Identity's config;
# production should normally contain only the canonical Identity origin.

IDENTITY_WEBAUTHN_RP_ID=identity.mattediworks.com
IDENTITY_WEBAUTHN_RP_NAME=MW Identity
IDENTITY_WEBAUTHN_ORIGINS=https://identity.mattediworks.com

# REQUIRED SECRET. Encrypts stored WebAuthn credential material.
# Same versioned 32-byte base64url format as IDENTITY_SIGNING_KEYS, but it must
# be independently generated. Keep older versions during key rotation.

IDENTITY_WEBAUTHN_CREDENTIAL_KEYS=1:<REQUIRED-BASE64URL-32-BYTE-KEY>
IDENTITY_WEBAUTHN_CREDENTIAL_ACTIVE_KEY_VERSION=1
IDENTITY_WEBAUTHN_CEREMONY_TTL_MINUTES=5


# =============================================================================
# MW Identity — TOTP, strong authentication, and recovery
# =============================================================================
# REQUIRED SECRET. Encrypts TOTP seeds at rest. Generate independently from all
# other keys. Supports comma-separated version:key entries for rotation.

IDENTITY_TOTP_SECRET_KEYS=1:<REQUIRED-BASE64URL-32-BYTE-KEY>
IDENTITY_TOTP_SECRET_ACTIVE_KEY_VERSION=1

# Name displayed by authenticator applications.
IDENTITY_TOTP_ISSUER=MW Identity

# Maximum age accepted for sensitive administrative operations after WebAuthn.
IDENTITY_STRONG_AUTH_MAX_AGE_MINUTES=5

# Recovery link/token validity.
IDENTITY_RECOVERY_TTL_MINUTES=10

# Stand-alone sign-up at /register (no application needed). Accounts are
# always public, never workforce. This global emergency switch also controls
# application-initiated registration; per-app signup flags are deprecated.
IDENTITY_PUBLIC_SIGNUP_ENABLED=true


# =============================================================================
# MW Identity — operational retention
# =============================================================================

IDENTITY_AUDIT_RETENTION_DAYS=180
IDENTITY_SIGNING_RETIRED_RETENTION_HOURS=72


# =============================================================================
# MW BFF — public URLs and Identity OIDC client
# =============================================================================
# The production Compose fixes APP_ENV=production, PORT=7200, and
# DATABASE_PATH=/app/data/bff.db. The BFF is private; Stackport routes public
# domains to Gateway's exposed container port 8080.
#
# BFF_PUBLIC_BASE_URL is the browser-visible admin origin and controls the OIDC
# callback URL. The Identity application must register this exact redirect URI:
#
#   https://admin.mattediworks.com/api/auth/callback

BFF_PUBLIC_BASE_URL=https://admin.mattediworks.com
BFF_IDENTITY_ISSUER=https://identity.mattediworks.com

# Private container-to-container transport. Keep the public issuer above even
# though discovery/token requests use this internal URL.
BFF_IDENTITY_INTERNAL_BASE_URL=http://mw-identity:7100

# REQUIRED CREDENTIALS. Create a confidential application in MW Identity with:
#   redirect URI: https://admin.mattediworks.com/api/auth/callback
#   scopes:       openid profile email identity.admin
#   audience:     mw-identity-admin
# The source application must also allow every BFF_DELEGATION_SCOPES value and
# audiences mw-oauth and mw-mail for downstream management. See
# docs/dev_docs/stackport-onboarding.md for fresh-database bootstrap commands.
# Store the one-time-issued secret immediately; Identity will not show it again.

BFF_OIDC_CLIENT_ID=<REQUIRED-PRODUCTION-CLIENT-ID>
BFF_OIDC_CLIENT_SECRET=<REQUIRED-PRODUCTION-CLIENT-SECRET>


# =============================================================================
# MW BFF — encrypted login transactions and admin sessions
# =============================================================================
# REQUIRED SECRET. Encrypts BFF OIDC transaction/session-sensitive state.
# Use an independently generated versioned 32-byte base64url key.

BFF_TRANSACTION_KEYS=1:<REQUIRED-BASE64URL-32-BYTE-KEY>
BFF_TRANSACTION_ACTIVE_KEY_VERSION=1

BFF_OIDC_TRANSACTION_TTL_MINUTES=10
BFF_ADMIN_SESSION_TTL_HOURS=8
BFF_OIDC_CLOCK_SKEW_SECONDS=60
BFF_IDENTITY_HTTP_TIMEOUT_SECONDS=5
BFF_STRONG_AUTH_MAX_AGE_MINUTES=5


# =============================================================================
# Delegated downstream permissions
# =============================================================================
# REQUIRED FOR THE COMPLETE CONTROL PLANE.
#
# The BFF exchanges its Identity subject token for narrowly scoped OAuth and
# Mail tokens. Keep this list aligned with the BFF route allowlists. Removing a
# scope disables the corresponding UI operation; adding unrelated scopes grants
# unnecessary privilege.
#
# Current required permissions:
#   OAuth: projects read/write/delete, credential rotation, policy read/write,
#          audit, metrics, and server/docs read.
#   Mail:  projects read/write/delete, credential rotation, email history,
#          usage, and server/docs read.

BFF_DELEGATION_SCOPES=oauth.projects.read oauth.projects.write oauth.projects.delete oauth.credentials.rotate oauth.policy.read oauth.policy.write oauth.audit.read oauth.metrics.read oauth.server.read mail.projects.read mail.projects.write mail.projects.delete mail.credentials.rotate mail.emails.read mail.usage.read mail.server.read

# Refresh delegated tokens this many seconds before their actual expiration.
BFF_DELEGATION_CACHE_SKEW_SECONDS=30


# =============================================================================
# MW OAuth federation
# =============================================================================
# REQUIRED URL. Use the private service URL when MW OAuth shares a trusted
# Docker network, or its protected HTTPS admin endpoint when deployed elsewhere.
# No trailing slash.
#
# BFF_OAUTH_HOST is normally empty. Set it only when the transport address and
# logical HTTP Host differ, for example local host.docker.internal development.

BFF_OAUTH_BASE_URL=https://oauth.mattediworks.com
BFF_OAUTH_HOST=
BFF_OAUTH_AUDIENCE=mw-oauth
BFF_OAUTH_HTTP_TIMEOUT_SECONDS=5


# =============================================================================
# MW Mail federation
# =============================================================================
# REQUIRED URL. Same transport/Host rules as MW OAuth. This administrative URL
# is used server-to-server by the BFF; VITE_EMAIL_API_BASE_URL above is the
# separate browser-facing MailTester endpoint.

BFF_MAIL_BASE_URL=https://mailgo.mattediworks.com
BFF_MAIL_HOST=
BFF_MAIL_AUDIENCE=mw-mail
BFF_MAIL_HTTP_TIMEOUT_SECONDS=5


# =============================================================================
# MW MQTT admin federation (OPTIONAL)
# =============================================================================
# Leave BFF_MQTT_BASE_URL empty to keep the /api/mqtt/* facade disabled. To enable
# it, register the `mw-mqtt` resource application in Identity, add the mqtt.*
# scopes to BFF_DELEGATION_SCOPES and to the BFF Identity application's allowed
# scopes, and add `mw-mqtt` to its allowed audiences (see
# docs/dev_docs/stackport-onboarding.md, section 3b). Scopes to append:
#
#   mqtt.clients.read mqtt.clients.write mqtt.clients.delete
#   mqtt.credentials.rotate mqtt.roles.read mqtt.roles.write
#   mqtt.roles.delete mqtt.server.read
#
# BFF_MQTT_HOST is normally empty, as for OAuth and Mail.

BFF_MQTT_BASE_URL=
BFF_MQTT_HOST=
BFF_MQTT_AUDIENCE=mw-mqtt
BFF_MQTT_HTTP_TIMEOUT_SECONDS=5
# BFF_MQTT_BASE_URL=https://admin-mqtt.mattediworks.com


# =============================================================================
# Localhost overrides
# =============================================================================
# Do not uncomment these in Stackport. For docker-compose-dev.yml, use these
# values in the real local `.env` while Vite runs on port 5173:
#
# IDENTITY_PUBLIC_ISSUER=http://localhost:7100
# IDENTITY_WEBAUTHN_RP_ID=localhost
# IDENTITY_WEBAUTHN_ORIGINS=http://localhost:7100
# BFF_PUBLIC_BASE_URL=http://localhost:5173
# BFF_IDENTITY_ISSUER=http://localhost:7100
# BFF_IDENTITY_INTERNAL_BASE_URL=http://mw-identity:7100
# BFF_OAUTH_BASE_URL=http://host.docker.internal:8282
# BFF_OAUTH_HOST=oauth.mattediworks.com
# BFF_MAIL_BASE_URL=http://host.docker.internal:8082
# BFF_MAIL_HOST=mailgo.mattediworks.com
# VITE_ADMIN_API_BASE_URL=http://localhost:5173/api
# VITE_IDENTITY_PUBLIC_URL=http://localhost:7100
# VITE_EMAIL_API_BASE_URL=http://localhost:8082

# Startup deletion dispatch setting; set explicitly in production. Consumers
# must implement the frozen contract before being connected.
# Emergency pause: set false and recreate/redeploy Identity with the updated
# environment (a plain Compose restart does not reload it). Requests still freeze the identity and persist durable work.
IDENTITY_DELETION_DISPATCH_ENABLED=true
