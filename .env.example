APP_ENV=development
GATEWAY_HOST_PORT=3050

IDENTITY_PUBLIC_ISSUER=https://identity.mattediworks.com
IDENTITY_SESSION_TTL_HOURS=168
IDENTITY_LOGIN_CSRF_TTL_MINUTES=10
IDENTITY_LOGIN_RATE_ATTEMPTS=10
IDENTITY_LOGIN_RATE_WINDOW_MINUTES=5
IDENTITY_SIGNING_KEYS=1:<base64url-32-byte-key>
IDENTITY_SIGNING_ACTIVE_KEY_VERSION=1
IDENTITY_AUTHORIZATION_CODE_TTL_MINUTES=5
IDENTITY_ACCESS_TOKEN_TTL_MINUTES=60
IDENTITY_ID_TOKEN_TTL_MINUTES=5
IDENTITY_DELEGATED_TOKEN_TTL_MINUTES=5

IDENTITY_WEBAUTHN_RP_ID=identity.mattediworks.com
IDENTITY_WEBAUTHN_RP_NAME=MW Identity
IDENTITY_WEBAUTHN_ORIGINS=https://identity.mattediworks.com
IDENTITY_WEBAUTHN_CREDENTIAL_KEYS=1:<base64url-32-byte-key>
IDENTITY_WEBAUTHN_CREDENTIAL_ACTIVE_KEY_VERSION=1
IDENTITY_WEBAUTHN_CEREMONY_TTL_MINUTES=5

BFF_PUBLIC_BASE_URL=https://admin.mattediworks.com
BFF_IDENTITY_ISSUER=https://identity.mattediworks.com
BFF_IDENTITY_INTERNAL_BASE_URL=http://mw-identity:7100
BFF_OIDC_CLIENT_ID=<confidential-client-id>
BFF_OIDC_CLIENT_SECRET=<one-time-issued-client-secret>
BFF_TRANSACTION_KEYS=1:<base64url-32-byte-key>
BFF_TRANSACTION_ACTIVE_KEY_VERSION=1
BFF_OIDC_TRANSACTION_TTL_MINUTES=10
BFF_ADMIN_SESSION_TTL_HOURS=8
BFF_OIDC_CLOCK_SKEW_SECONDS=60
BFF_IDENTITY_HTTP_TIMEOUT_SECONDS=5

# The BFF OIDC application must allow:
#   scopes: openid profile email identity.admin
#   audience: mw-identity-admin

# Extra service permissions the BFF requests on its Identity subject token.
BFF_DELEGATION_SCOPES=
BFF_DELEGATION_CACHE_SKEW_SECONDS=30

# MW Plane Control Step 10 — MW OAuth admin federation.
# When enabled, BFF_DELEGATION_SCOPES must include the oauth.* scopes used by the facade.
BFF_OAUTH_BASE_URL=
# Optional logical Host override when transport address differs.
BFF_OAUTH_HOST=
BFF_OAUTH_AUDIENCE=mw-oauth
BFF_OAUTH_HTTP_TIMEOUT_SECONDS=5

# MW Plane Control Step 11 — MW Mail admin federation.
# When enabled, BFF_DELEGATION_SCOPES must include the mail.* scopes used by the facade.
BFF_MAIL_BASE_URL=
# Optional logical Host override when transport address differs.
BFF_MAIL_HOST=
BFF_MAIL_AUDIENCE=mw-mail
BFF_MAIL_HTTP_TIMEOUT_SECONDS=5

# Step 12 strong authentication
IDENTITY_TOTP_SECRET_KEYS=
IDENTITY_TOTP_SECRET_ACTIVE_KEY_VERSION=1
IDENTITY_TOTP_ISSUER=MW Identity
IDENTITY_STRONG_AUTH_MAX_AGE_MINUTES=5
IDENTITY_RECOVERY_TTL_MINUTES=10
BFF_STRONG_AUTH_MAX_AGE_MINUTES=5

# Step 13 operational hardening
IDENTITY_AUDIT_RETENTION_DAYS=180
IDENTITY_SIGNING_RETIRED_RETENTION_HOURS=72
